{
  "name": "jaduu",
  "productName": "JADUU",
  "version": "0.1.0",
  "description": "JADUU — Apki soch ka digital saathi. A private, local-first AI desktop assistant powered by Ollama.",
  "author": {
    "name": "JADUU",
    "email": "hello@jaduu.app"
  },
  "license": "MIT",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/launch.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "gen:assets": "node scripts/gen-assets.mjs",
    "build": "npm run gen:assets && npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src scripts",
    "test": "node scripts/test.mjs",
    "test:watch": "vitest",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "build:windows": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "electron-updater": "^6.3.9",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.13.0",
    "highlight.js": "^11.10.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.0",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.17.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  }
}
